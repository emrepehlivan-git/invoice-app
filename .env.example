# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=invoice_app
DATABASE_URL=postgresql://postgres:password@localhost:5432/invoice_app

# Paddle (optional, for subscriptions)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_DEFAULT_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Email (optional; omit for Ethereal in development)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Invoice App
EMAIL_FROM_ADDRESS=noreply@example.com

# Cron (optional; for secured cron endpoints)
# CRON_SECRET=
